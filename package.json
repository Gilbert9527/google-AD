{
  "name": "google-ad-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Google 广告投放网站采集、分类与分析平台（Cloudflare Workers + D1）",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "db:local": "wrangler d1 execute google-ad --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute google-ad --remote -y --file=./schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.0",
    "typescript": "^5.6.3",
    "wrangler": "^4.24.0"
  }
}
